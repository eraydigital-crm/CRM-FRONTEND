# Base URL of the Symfony API (CGA-BACKEND).
#
# Leave EMPTY when the front is served by the backend, or when you use the Vite
# dev proxy (npm run dev): calls then go to /api on the same origin, and the
# HttpOnly JWT cookie is used.
#
# Set it to the API origin (e.g. https://api.eray-crm.com) when the front is
# deployed separately: the JWT returned by /api/auth/login is then stored
# client-side and sent as a Bearer token.
VITE_API_BASE_URL=

# Backend the dev proxy forwards /api to (defaults to http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
